# Original commercial ROM is the reference of truth but is NOT versioned (neither is the built mobile_trainer.gbc).
# Its identity is recorded in roms.sha256 / docs/ROM_INFO.md.
*.gbc
*.cgb
*.gb
*.sav
*.rtc
*.ss?
# build products (mobile_trainer.gbc is covered by *.gbc above; objects, .map, .sym and .d files live in build/)
build/
*.o
*.pyc
__pycache__/
# local scratch / tool caches (Ghidra projects, downloaded extensions, traces)
.tmp/
.cache/
scratch/
traces/*.bin
tools/ghidra/project/

# generated .2bpp assets (source PNGs are versioned)
gfx/**/*.2bpp
languages/en/**/*.2bpp
!gfx/account/settings_menu_and_manual_confirm_bank4a/settings_menu_cursor_frames_anim_script_byteview_4a_5860.2bpp
!gfx/settings/adapter_check_and_phone_entry_bank4a/legacy_byteviews/adapter_check_object_data_4a_68d0.2bpp
