# --- list full: delete the last entry (4th icon), cancel once, then confirm
tap A
wait 60
tap RIGHT x3
wait 40
shot bar_delete
tap A
waitstable 60 max 600
shot del_confirm
tap A
waitstable 60 max 600
shot del_1
tap A
waitstable 60 max 600
shot del_2
tap RIGHT x3               # the cancel reset the icon bar to its first icon
wait 40
tap A                        # confirmation again
waitstable 60 max 600
tap LEFT
wait 40
tap A                        # はい
waitstable 60 max 600
shot del_done
tap B
waitstable 60 max 600
shot mail_menu
