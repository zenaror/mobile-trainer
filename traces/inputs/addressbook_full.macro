tap LEFT x5
tap A
tap DOWN x2
tap RIGHT x4
tap A
tap UP x2
tap LEFT x3
tap A
tap START
wait 40
tap A
waitstable 60 max 600
shot slot4_after_addr
tap A
waitstable 60 max 600
tap A x2
tap START
wait 40
tap A
waitstable 60 max 600
shot slot4_confirm
tap A
waitstable 60 max 600
shot slot4_saved
