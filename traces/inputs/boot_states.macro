tap A
waitstable 60 max 600
shot bank1_B010_a1
tap A
waitstable 60 max 600
shot bank1_B010_a2
# --- bank1_A9F0
sram 1:A9F0=5A
sram 1:A9F1=A5
reset
wait 1000
shot bank1_A9F0_boot
tap A
waitstable 60 max 600
shot bank1_A9F0_a1
tap A
waitstable 60 max 600
shot bank1_A9F0_a2
# --- bank2_A010
sram 2:A010=5A
sram 2:A011=A5
reset
wait 1000
shot bank2_A010_boot
tap A
waitstable 60 max 600
shot bank2_A010_a1
tap A
waitstable 60 max 600
shot bank2_A010_a2
# --- bank3_A000
sram 3:A000=5A
sram 3:A001=A5
reset
wait 1000
shot bank3_A000_boot
tap A
waitstable 60 max 600
shot bank3_A000_a1
tap A
waitstable 60 max 600
shot bank3_A000_a2
# --- cfg_magic
cfg 0=58
reset
wait 1000
shot cfg_magic_boot
tap A
waitstable 60 max 600
shot cfg_magic_a1
tap A
waitstable 60 max 600
shot cfg_magic_a2
# --- cfg_sum
cfg BF=00
cfg BE=00
reset
wait 1000
shot cfg_sum_boot
tap A
waitstable 60 max 600
shot cfg_sum_a1
tap A
waitstable 60 max 600
shot cfg_sum_a2
# --- sram_zero
sramfill 00
reset
wait 1000
shot sram_zero_boot
tap A
waitstable 60 max 600
shot sram_zero_a1
tap A
waitstable 60 max 600
shot sram_zero_a2
# --- sram_ff
sramfill FF
reset
wait 1000
shot sram_ff_boot
tap A
waitstable 60 max 600
shot sram_ff_a1
tap A
waitstable 60 max 600
shot sram_ff_a2
# --- cfg_zero
