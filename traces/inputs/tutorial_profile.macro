shot nickname_keyboard
tap A x3                     # 3 x 'あ'
wait 30
shot nickname_typed
tap START                    # jump to OK
wait 30
tap A                        # OK
waitstable 60 max 300
shot mail_menu
tap A                        # "おくる/うけとる" (send/receive)
waitstable 60 max 300
shot send_receive_confirm
tap A                        # "はい"
waitstable 60 max 300
shot password_saved
tap A                        # "0でつうしんをはじめる"
waitstable 60 max 300
shot connecting
waitstable 60 max 900
shot ending_connection
waitstable 60 max 900
shot comm_finished_1
waitstable 60 max 900
shot comm_finished_2
tap A
waitstable 60 max 900
shot comm_result
tap A
waitstable 60 max 900
shot mail_server_status
